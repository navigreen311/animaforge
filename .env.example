# AnimaForge Environment Variables
# Copy this to .env and fill in real values

# Database
DATABASE_URL=postgresql://animaforge:YOUR_PASSWORD_HERE@localhost:5432/animaforge
REDIS_URL=redis://localhost:6379

# Auth
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN_HERE
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID_HERE
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET_HERE
# Required. The auth service signs session tokens with this; platform-api and
# the realtime service verify against it. All three must share the same value,
# and none of them has a fallback -- each fails at startup without it, because a
# default secret committed to the repository is a published secret (#82).
JWT_SECRET=YOUR_JWT_SECRET_HERE

# AWS / Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY_HERE
S3_BUCKET=animaforge-assets
CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN_HERE

# AI Services
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# Stripe Billing
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
# Price IDs from Stripe Dashboard > Products
STRIPE_PRICE_CREATOR=price_creator_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_STUDIO=price_studio_placeholder
# Portal return URL
BILLING_RETURN_URL=http://localhost:3000/billing

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# App
NODE_ENV=development
PORT=3000
API_PORT=3001
AI_API_PORT=8001
REALTIME_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_AI_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:3002

# --- governance ---
# Real C2PA signing. Both must be set, or the service runs in a clearly-labelled
# degraded mode that records provenance but signs and embeds nothing. Each value
# is either an inline PEM or a path to one.
#   C2PA_SIGNING_CERT  leaf certificate + issuing chain, PEM, leaf first.
#                      The leaf needs extendedKeyUsage=emailProtection and
#                      keyUsage=digitalSignature, per the C2PA spec.
#   C2PA_PRIVATE_KEY   matching private key in PKCS#8 ("BEGIN PRIVATE KEY").
#                      SEC1 ("BEGIN EC PRIVATE KEY") is rejected by c2pa-rs.
C2PA_SIGNING_CERT=YOUR_C2PA_CERT_CHAIN_PEM_OR_PATH_HERE
C2PA_PRIVATE_KEY=YOUR_C2PA_PRIVATE_KEY_PEM_OR_PATH_HERE
C2PA_SIGNING_ALGORITHM=es256
# c2pa-node requires a reachable RFC 3161 timestamp authority to sign at all.
C2PA_TSA_URL=http://timestamp.digicert.com
C2PA_JSON_LIMIT=96mb

# Invisible watermarking (algorithm dct-pair-v1, built in — no credential needed).
# WATERMARK_SEED keys block placement. Rotating it makes previously embedded
# marks unreadable unless their database record survives, so treat it as a secret
# and rotate deliberately.
WATERMARK_SEED=YOUR_WATERMARK_SEED_HERE
WATERMARK_STRENGTH=20
WATERMARK_JSON_LIMIT=96mb
# Fetching arbitrary URLs server-side is an SSRF pivot; off unless you need it.
WATERMARK_ALLOW_REMOTE_FETCH=false
WATERMARK_MAX_REMOTE_BYTES=67108864
# Optional TrustMark backend. Requires `pip install trustmark` plus torch and
# model weights, none of which this repo ships. Leave unset to use dct-pair-v1.
WATERMARK_ENGINE=dct-pair-v1
TRUSTMARK_PYTHON=python3

# Video watermarking and video fingerprinting shell out to ffmpeg/ffprobe.
# Leave unset to use whatever is on PATH; both features report themselves
# unavailable when the binaries are missing.
FFMPEG_PATH=
FFPROBE_PATH=

# Piracy monitoring (X4)
# Candidate discovery needs an external search index. With no provider the
# scanner honestly reports that it examined zero candidates.
PIRACY_SEARCH_PROVIDER=none
PIRACY_SEARCH_ENDPOINT=
PIRACY_SEARCH_API_KEY=YOUR_SEARCH_API_KEY_HERE
PIRACY_ALLOW_REMOTE_FETCH=false
PIRACY_MAX_CANDIDATE_BYTES=67108864
PIRACY_JSON_LIMIT=96mb
# Max Hamming distance (of 64 bits) still counted as a match.
FINGERPRINT_MATCH_THRESHOLD=10
FINGERPRINT_VIDEO_SAMPLES=9
FINGERPRINT_SEARCH_LIMIT=5000
# Piracy scans ask this service to recover watermarks; unset means "not checked".
WATERMARK_SERVICE_URL=http://localhost:3007

# Web app — the verify page and piracy dashboard read live status from these.
NEXT_PUBLIC_C2PA_SERVICE_URL=http://localhost:3006
NEXT_PUBLIC_PIRACY_SERVICE_URL=http://localhost:3016

# --- infra ---
# Event bus (packages/events).
#
# EVENT_BUS_BACKEND selects the implementation explicitly. Leave it unset and
# the backend is inferred: Kafka if KAFKA_BROKERS is set, otherwise the
# in-process bus. Whichever is chosen is announced in the logs at startup —
# a process must never think it is publishing to Kafka when it is not.
#
#   kafka   real broker, events cross service boundaries, durable and replayable
#   memory  in-process only. Nothing leaves the process, nothing is persisted,
#           no other service sees the events. Local dev and tests only.
EVENT_BUS_BACKEND=memory

# Comma-separated. Inside docker compose use kafka:29092; from the host use
# localhost:9092 (the broker advertises both listeners).
KAFKA_BROKERS=

# Optional transport security for a managed broker.
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=YOUR_KAFKA_PASSWORD_HERE

# Create the topics in packages/events/src/topics.ts at startup if missing.
# Useful for a bare dev broker; leave off in production, where partition counts
# should be provisioned deliberately.
KAFKA_ENSURE_TOPICS=false

# Starting with NODE_ENV=production on the in-process bus is refused outright:
# every cross-service event would be silently dropped. Set this only to accept
# that deliberately — it still logs at error level on every startup.
EVENT_BUS_ALLOW_MEMORY_IN_PRODUCTION=false

# WebRTC signalling (services/live).
#
# STUN alone lets two peers find each other and connect directly. That fails
# behind symmetric NAT — corporate networks, some mobile carriers — where the
# only route is a TURN relay both peers connect out to. Industry measurements
# put that at roughly 10-20% of connections.
#
# With no TURN configured those calls do not fail loudly: ICE never completes
# and the user watches a spinner. So the service warns at startup, reports it
# on /health, and tells every client in its `joined` message.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Set all three together. TURN_URLS without credentials is refused rather than
# advertised, because a relay the client cannot authenticate against fails the
# same way as no relay at all, only harder to diagnose.
WEBRTC_TURN_URLS=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=YOUR_TURN_CREDENTIAL_HERE

# --- avatar ---
# X5 Avatar Studio reconstruction pipeline (services/ai-api).
# GET /ai/v1/avatar/capabilities reports the true state of everything below.

# Reconstruction engine.
#   mock (default) - procedural CPU engine. Produces real, exportable mesh and
#                    splat artifacts, but the geometry is synthesised from the
#                    character id; the reference photographs are NOT analysed.
#                    Every response carries engine="mock" and is_mock=true.
#   real           - nerfstudio splatfacto (3D Gaussian Splatting). Needs a
#                    CUDA GPU, requirements-ml.txt installed, and the weights
#                    directory below. If any of that is missing the API returns
#                    503; it never falls back to mock output silently.
AVATAR_ENGINE=mock

# Directory holding downloaded model weights. Required for AVATAR_ENGINE=real.
AVATAR_WEIGHTS_DIR=

# Licensed models the pipeline reports as unavailable when unset. Neither is
# bundled; see docs/avatar-studio.md for the licences a human must accept.
AVATAR_FLAME_MODEL_PATH=
AVATAR_IDENTITY_MODEL_PATH=

# Artifact storage. local writes under AVATAR_STORAGE_DIR and returns file://
# URLs unless AVATAR_STORAGE_BASE_URL is set; s3 needs boto3 and a bucket.
AVATAR_STORAGE_BACKEND=local
AVATAR_STORAGE_DIR=var/avatar-artifacts
AVATAR_STORAGE_BASE_URL=
AVATAR_S3_BUCKET=
AVATAR_S3_PREFIX=

# --- generation ---
# Engine selection per generation cluster. Every one defaults to a safe value,
# so an empty file runs. `GET /ai/v1/capabilities` reports the true state of
# each on the running host, and every mock response carries is_mock=true.
#
# `real` is honoured only where an engine adapter exists. Where it does not,
# the request fails with an explanation rather than returning synthetic output
# labelled as real. See docs/generation-pipeline.md for which is which.

# Real on CPU with no provisioning. Set to `mock` only to compare behaviour.
SCENE_GRAPH_ENGINE=real
MOCAP_ENGINE=real
PHYSICS_ENGINE=real
QC_ENGINE=real
CONTINUITY_ENGINE=real

# No adapter written yet: these return labelled mock output whatever is set.
VIDEO_ENGINE=mock
AUDIO_ENGINE=mock
STYLE_ENGINE=mock
DUBBING_ENGINE=mock
TRAINING_ENGINE=mock
MUSIC_ENGINE=mock

# Weights directories, read when the matching engine is set to `real`.
CONTINUITY_WEIGHTS_DIR=
VIDEO_WEIGHTS_DIR=
AUDIO_WEIGHTS_DIR=
STYLE_WEIGHTS_DIR=
DUBBING_WEIGHTS_DIR=
TRAINING_WEIGHTS_DIR=
MUSIC_WEIGHTS_DIR=
# --- persistence ---
# apps/web API routes proxy to services/platform-api (docs/persistence.md).
# Server-side only; the browser never talks to platform-api directly.
PLATFORM_API_URL=http://localhost:4000

# --- engines ---
# Per-cluster generation engines for services/ai-api. Each is mock|real.
# GET /ai/v1/capabilities reports the true state of every one of them: which
# packages are importable, whether the weights directory exists, and which
# engine a request would actually run with. Setting a var to `real` on a host
# that cannot honour it makes requests fail loudly; it never downgrades to
# synthetic output labelled real.
#
# Heavy dependencies live in services/ai-api/requirements-ml.txt and are never
# installed by CI. Hardware floors, weights and licences are in
# docs/generation-pipeline.md.

# D4 audio. Real by default: rule-based ARPABET G2P and a segmental duration
# model drive lip-sync on CPU with no weights. Setting `real` additionally
# enables CTC forced alignment against a waveform once torch + torchaudio and
# the weights directory are present. Speech synthesis is not implemented at all.
AUDIO_ENGINE=mock
AUDIO_WEIGHTS_DIR=

# X6 style. Real by default: palette, contrast and edge density measured from
# decoded pixels on CPU. The gated upgrade is CLIP semantic embedding. Style
# transfer is not implemented.
STYLE_ENGINE=mock
STYLE_WEIGHTS_DIR=
STYLE_CLIP_MODEL=
STYLE_CLIP_PRETRAINED=

# D3/D6 video. Gated: needs a CUDA GPU and multi-gigabyte diffusion weights.
# Unprovisioned, jobs are queued with no preview URL.
VIDEO_ENGINE=mock
VIDEO_WEIGHTS_DIR=
VIDEO_MODEL_ID=
VIDEO_I2V_MODEL_ID=

# F3 music. Gated: audiocraft/MusicGen. The small checkpoint runs on CPU but
# takes minutes per cue; larger sizes need a GPU.
MUSIC_ENGINE=mock
MUSIC_WEIGHTS_DIR=
MUSIC_MODEL_ID=

# D10 training. Gated: LoRA fine-tuning via diffusers + peft, needs a CUDA GPU.
TRAINING_ENGINE=mock
TRAINING_WEIGHTS_DIR=
TRAINING_BASE_MODEL=

# G2 dubbing. NOT IMPLEMENTED -- no adapter exists, so setting this to `real`
# changes nothing except that requests fail instead of returning mock output.
DUBBING_ENGINE=mock
DUBBING_WEIGHTS_DIR=

# Clusters that are real with nothing provisioned. Listed so the set is
# complete, not because they need configuring.
SCENE_GRAPH_ENGINE=real
MOCAP_ENGINE=real
PHYSICS_ENGINE=real
QC_ENGINE=real
CONTINUITY_ENGINE=real
CONTINUITY_WEIGHTS_DIR=
