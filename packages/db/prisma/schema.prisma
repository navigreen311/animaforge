generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [uuidOssp(map: "uuid-ossp")]
}

// ============================================
// IDENTITY & AUTH
// ============================================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique
  displayName   String?  @map("display_name")
  avatarUrl     String?  @map("avatar_url")
  orgId         String?  @map("org_id") @db.Uuid
  role          String   @default("creator") // creator|editor|admin|enterprise
  tier          String   @default("free") // free|creator|pro|studio|enterprise
  genMemory     Json     @default("{}") @map("gen_memory")
  stylePrefs    Json     @default("{}") @map("style_prefs")
  consentFlags  Json     @default("{}") @map("consent_flags")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  onboardingComplete Boolean @default(false) @map("onboarding_complete")
  referralCode         String?   @unique @map("referral_code")
  referredBy           String?   @map("referred_by")
  referralCredits      Int       @default(0) @map("referral_credits")
  triggeredMilestones  String[]  @default([]) @map("triggered_milestones")
  cookieConsent        Json      @default("{}") @map("cookie_consent")
  welcomeEmailSent     Boolean   @default(false) @map("welcome_email_sent")
  pushToken            String?   @map("push_token")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  organization  Organization? @relation(fields: [orgId], references: [id])
  projects      Project[]
  characters    Character[]
  jobs          GenerationJob[]
  apiKeys       ApiKey[]
  approvedShots Shot[]    @relation("ApprovedBy")

  @@map("users")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  users     User[]
  projects  Project[]
  teams     Team[]

  @@map("organizations")
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [orgId], references: [id])
  members      Membership[]

  @@map("teams")
}

model Membership {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role   String @default("member")

  team Team @relation(fields: [teamId], references: [id])

  @@map("memberships")
}

model ApiKey {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  keyHash   String   @unique @map("key_hash")
  scopes    String[] @default([])
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("api_keys")
}

// ============================================
// PROJECTS & SHOTS
// ============================================

model Project {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  orgId        String?  @map("org_id") @db.Uuid
  title        String
  description  String?
  worldBible   Json     @default("{}") @map("world_bible")
  brandKit     Json     @default("{}") @map("brand_kit")
  styleLock    Json     @default("{}") @map("style_lock")
  status       String   @default("active")
  phase        String   @default("pre_production")
  modelVersion String?  @map("model_version")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  reviewToken          String?   @unique @map("review_token")
  reviewTokenExpiresAt DateTime? @map("review_token_expires_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  owner        User         @relation(fields: [ownerId], references: [id])
  organization Organization? @relation(fields: [orgId], references: [id])
  scenes       Scene[]
  shots        Shot[]
  jobs         GenerationJob[]

  @@map("projects")
}

model Scene {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  title     String
  order     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id])
  shots   Shot[]

  @@map("scenes")
}

model Shot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sceneId       String   @map("scene_id") @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  shotNumber    Int      @map("shot_number")
  sceneGraph    Json     @map("scene_graph")
  prompt        String?
  styleRef      String?  @map("style_ref") @db.Uuid
  characterRefs String[] @map("character_refs") @db.Uuid
  audioTrackId  String?  @map("audio_track_id") @db.Uuid
  durationMs    Int?     @map("duration_ms")
  aspectRatio   String   @default("16:9") @map("aspect_ratio")
  status        String   @default("draft")
  approvedBy    String?  @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  scene      Scene   @relation(fields: [sceneId], references: [id])
  project    Project @relation(fields: [projectId], references: [id])
  approver   User?   @relation("ApprovedBy", fields: [approvedBy], references: [id])
  jobs       GenerationJob[]

  @@map("shots")
}

// ============================================
// CHARACTERS & ASSETS
// ============================================

model Character {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String?  @map("project_id") @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  name          String
  isDigitalTwin Boolean  @default(false) @map("is_digital_twin")
  faceModelUrl  String?  @map("face_model_url")
  bodyParams    Json     @default("{}") @map("body_params")
  hairParams    Json     @default("{}") @map("hair_params")
  wardrobe      Json     @default("{}")
  voiceId       String?  @map("voice_id")
  styleMode     String   @default("realistic") @map("style_mode")
  facsRigUrl    String?  @map("facs_rig_url")
  gltfUrl       String?  @map("gltf_url")
  consentRecord String?  @map("consent_record") @db.Uuid
  rightsStatus  String   @default("personal") @map("rights_status")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User @relation(fields: [ownerId], references: [id])

  @@map("characters")
}

model Asset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  type      String   // image|video|audio|model|style_pack
  name      String
  url       String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("assets")
}

model StylePack {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  creatorId   String   @map("creator_id") @db.Uuid
  fingerprint Json     // StyleFingerprint
  sourceUrl   String   @map("source_url")
  sourceType  String   @map("source_type") // video|animation
  isPublic    Boolean  @default(false) @map("is_public")
  price       Float?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("style_packs")
}

// ============================================
// GENERATION JOBS
// ============================================

model GenerationJob {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shotId       String?  @map("shot_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  jobType      String   @map("job_type")
  modelId      String   @map("model_id")
  inputParams  Json     @map("input_params")
  inputHash    String?  @map("input_hash")
  tier         String   @default("preview")
  status       String   @default("queued")
  progress     Int      @default(0)
  outputUrl    String?  @map("output_url")
  c2paManifest String?  @map("c2pa_manifest")
  watermarkId  String?  @map("watermark_id")
  qualityScores Json?   @map("quality_scores")
  costCredits  Float?   @map("cost_credits")
  gpuClass     String?  @map("gpu_class")
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  isPublic       Boolean  @default(false) @map("is_public")
  publicCaption  String?  @map("public_caption")
  publicLikes    Int      @default(0) @map("public_likes")

  shot    Shot?   @relation(fields: [shotId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("generation_jobs")
}

// ============================================
// AUDIO & TIMELINE
// ============================================

model AudioTrack {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  type      String   // voice|sfx|music|mixed
  url       String
  duration  Int      // milliseconds
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audio_tracks")
}

// ============================================
// GOVERNANCE
// ============================================

model Consent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  grantedBy    String   @map("granted_by") @db.Uuid
  consentType  String   @map("consent_type") // face|voice|likeness
  scope        String   // personal|commercial
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("consents")
}

model ModerationLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String   @map("job_id") @db.Uuid
  result    String   // pass|flag|block
  category  String?
  score     Float?
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("moderation_logs")
}

model AuditTrail {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String
  resource  String
  resourceId String  @map("resource_id") @db.Uuid
  details   Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_trail")
}

// ============================================
// COMMERCE
// ============================================

model Subscription {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  stripeId      String   @unique @map("stripe_id")
  tier          String
  status        String   @default("active")
  currentPeriodEnd DateTime @map("current_period_end") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("subscriptions")
}

model UsageMeter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  period    String   // YYYY-MM
  credits   Float    @default(0) @map("credits_used")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([userId, period])
  @@map("usage_meters")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String?
  actionUrl String?  @map("action_url")
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ============================================
// REVIEW PORTAL
// ============================================

model ShotReview {
  id           String   @id @default(cuid())
  shotId       String   @map("shot_id")
  projectId    String   @map("project_id")
  reviewerName String   @map("reviewer_name")
  action       String
  comment      String?
  token        String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([shotId])
  @@index([projectId])
  @@map("shot_reviews")
}

// ============================================
// PUBLISHING
// ============================================

model PublishJob {
  id          String    @id @default(cuid())
  projectId   String    @map("project_id")
  userId      String    @map("user_id")
  exportUrl   String    @map("export_url")
  platform    String
  title       String
  description String?
  tags        String[]  @default([])
  scheduledAt DateTime  @map("scheduled_at") @db.Timestamptz
  publishedAt DateTime? @map("published_at") @db.Timestamptz
  status      String    @default("scheduled")
  platformId  String?   @map("platform_id")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@map("publish_jobs")
}

// ============================================
// PRESENCE
// ============================================

model UserPresence {
  userId      String   @id @map("user_id")
  orgId       String?  @map("org_id")
  currentPage String?  @map("current_page")
  status      String   @default("offline")
  lastSeen    DateTime @default(now()) @map("last_seen") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@map("user_presences")
}

// ============================================
// FEEDBACK & CHANGELOG
// ============================================

model Feedback {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  type       String
  message    String
  currentUrl String?  @map("current_url")
  userAgent  String?  @map("user_agent")
  metadata   Json     @default("{}")
  status     String   @default("new")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([type, status])
  @@map("feedbacks")
}

model ChangelogView {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  version   String
  viewedAt  DateTime @default(now()) @map("viewed_at") @db.Timestamptz
  @@unique([userId, version])
  @@map("changelog_views")
}

// ============================================
// REFERRALS
// ============================================

model ReferralRecord {
  id          String    @id @default(cuid())
  referrerId  String    @map("referrer_id")
  refereeId   String    @unique @map("referee_id")
  status      String    @default("pending")
  creditedAt  DateTime? @map("credited_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  @@index([referrerId])
  @@map("referral_records")
}

// ============================================
// FEATURE FLAGS
// ============================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  rolloutPct  Int      @default(0) @map("rollout_pct")
  allowlist   String[] @default([])
  blocklist   String[] @default([])
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@map("feature_flags")
}

// ============================================
// INCIDENTS
// ============================================

model Incident {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String
  services    String[]
  status      String   @default("investigating")
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updates     IncidentUpdate[]
  @@map("incidents")
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String   @map("incident_id")
  message    String
  status     String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  incident   Incident @relation(fields: [incidentId], references: [id])
  @@map("incident_updates")
}

// ============================================
// WEBHOOK DELIVERIES
// ============================================

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String   @map("webhook_id")
  event          String
  requestBody    String   @map("request_body")
  requestHeaders Json     @map("request_headers")
  responseStatus Int?     @map("response_status")
  responseBody   String?  @map("response_body")
  durationMs     Int?     @map("duration_ms")
  success        Boolean  @default(false)
  error          String?
  attemptNumber  Int      @default(1) @map("attempt_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ============================================
// LIVE RUNTIME
// ============================================

model LiveSession {
  id          String   @id @default(cuid())
  // services/live creates sessions from a project, not a user, and supplies no
  // userId — so this is nullable and projectId/mode were added to match what
  // the service actually writes. Without them liveSession.create fails, and the
  // LiveRecording/LiveChatMessage rows below would reference sessions that can
  // never exist.
  userId      String?  @map("user_id")
  projectId   String?  @map("project_id")
  mode        String?  // interactive|broadcast|rehearsal
  avatarId    String?  @map("avatar_id")
  status      String   @default("offline")
  destinations String[] @default([])
  startedAt   DateTime? @map("started_at") @db.Timestamptz
  endedAt     DateTime? @map("ended_at") @db.Timestamptz
  viewerPeak  Int      @default(0) @map("viewer_peak")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId])
  @@index([projectId])
  @@map("live_sessions")
}

model BranchingScene {
  id           String   @id @default(cuid())
  narrativeId  String   @map("narrative_id")
  name         String
  triggerType  String   @map("trigger_type")
  emotion      String?
  pose         String?
  position     Json     @default("{}")
  @@index([narrativeId])
  @@map("branching_scenes")
}

// ============================================
// PIRACY MONITORING
// ============================================

model PiracyMatch {
  id              String   @id @default(cuid())
  outputId        String   @map("output_id")
  userId          String   @map("user_id")
  platform        String
  matchUrl        String   @map("match_url")
  matchStrength   Float    @map("match_strength")
  watermarkFound  Boolean  @default(false) @map("watermark_found")
  status          String   @default("pending")
  detectedAt      DateTime @default(now()) @map("detected_at") @db.Timestamptz
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz

  // Perceptual-fingerprint evidence. `matchMethod` records how the match was
  // reached so a review never has to guess whether it was a durable signal.
  fingerprintId   String?  @map("fingerprint_id")
  matchMethod     String   @default("unknown") @map("match_method") // perceptual-hash|watermark|manual|unknown
  hammingDistance Int?     @map("hamming_distance")
  watermarkId     String?  @map("watermark_id")
  evidence        Json     @default("{}")

  fingerprint     Fingerprint? @relation(fields: [fingerprintId], references: [id])

  @@index([userId, status])
  @@index([fingerprintId])
  @@map("piracy_matches")
}

model DMCANotice {
  id          String   @id @default(cuid())
  matchId     String   @map("match_id")
  userId      String   @map("user_id")
  platform    String   @default("unknown")
  status      String   @default("draft")
  body        String?
  filedAt     DateTime? @map("filed_at") @db.Timestamptz
  caseNumber  String?  @map("case_number")
  responseAt  DateTime? @map("response_at") @db.Timestamptz
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([matchId])
  @@map("dmca_notices")
}

// ============================================
// PROVENANCE — C2PA, WATERMARKS, FINGERPRINTS
// ============================================

/// One row per signed (or attempted) output. `mode` and `signed` are what
/// separate a real embedded C2PA manifest from an unsigned degraded record;
/// nothing downstream may treat the two alike.
model C2PAManifest {
  id                String    @id @default(cuid())
  outputId          String    @unique @map("output_id")
  jobId             String    @map("job_id")
  projectId         String?   @map("project_id")
  /// SHA-256 of the user id, never the raw id — manifests are public.
  userIdHash        String?   @map("user_id_hash")
  assetUrl          String?   @map("asset_url")
  assetPath         String?   @map("asset_path")
  assetSha256       String?   @map("asset_sha256")
  signedAssetSha256 String?   @map("signed_asset_sha256")
  format            String
  manifestLabel     String?   @map("manifest_label")
  claimGenerator    String    @map("claim_generator")
  signatureAlg      String?   @map("signature_alg")
  certSerialNumber  String?   @map("cert_serial_number")
  certIssuer        String?   @map("cert_issuer")
  timestampedAt     DateTime? @map("timestamped_at") @db.Timestamptz
  /// True only when a COSE signature was produced by a real certificate.
  signed            Boolean   @default(false)
  /// True only when the manifest was written into the asset bytes.
  embedded          Boolean   @default(false)
  mode              String    @default("degraded") // c2pa-embedded|unsigned-record|degraded
  degradedReason    String?   @map("degraded_reason")
  manifestJson      Json      @default("{}") @map("manifest_json")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([jobId])
  @@index([signedAssetSha256])
  @@map("c2pa_manifests")
}

/// Index from a recovered watermark payload back to the job that produced it.
/// The payload lives in the pixels; this row is only the lookup table.
model Watermark {
  id           String   @id @default(cuid())
  watermarkId  String   @unique @map("watermark_id")
  jobId        String   @map("job_id")
  outputId     String?  @map("output_id")
  userId       String?  @map("user_id")
  /// The 48-bit payload key carried by the pixels, hex encoded.
  payloadHex   String   @map("payload_hex")
  algorithm    String   @default("dct-pair-v1")
  strength     Float    @default(20)
  /// Keying material for block placement; stored so rotating it stays readable.
  seed         String
  mediaType    String   @map("media_type")
  /// embedded = pixels altered; registered-only = no asset was supplied.
  mode         String   @default("embedded")
  sourceSha256 String?  @map("source_sha256")
  markedSha256 String?  @map("marked_sha256")
  outputUrl    String?  @map("output_url")
  metadata     Json     @default("{}")
  embeddedAt   DateTime @default(now()) @map("embedded_at") @db.Timestamptz

  @@index([jobId])
  @@index([payloadHex])
  @@map("watermarks")
}

/// Perceptual fingerprint of a protected output. Unlike a cryptographic hash
/// these stay close under re-encode and rescale, which is what makes
/// near-duplicate search possible at all.
model Fingerprint {
  id           String   @id @default(cuid())
  outputId     String   @map("output_id")
  userId       String?  @map("user_id")
  mediaType    String   @map("media_type") // image|video
  algorithm    String   @default("phash-dct64")
  /// 64-bit DCT perceptual hash, hex encoded.
  phash        String
  ahash        String?
  dhash        String?
  /// Per-sampled-frame pHashes for video, in timeline order.
  frameHashes  String[] @default([]) @map("frame_hashes")
  durationMs   Int?     @map("duration_ms")
  width        Int?
  height       Int?
  sourceSha256 String?  @map("source_sha256")
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  matches      PiracyMatch[]

  @@index([outputId])
  @@index([phash])
  @@map("fingerprints")
}

// ============================================
// PRODUCTION CALENDAR
// ============================================

model CalendarEvent {
  id          String   @id @default(cuid())
  projectId   String?  @map("project_id")
  userId      String   @map("user_id")
  title       String
  type        String
  startDate   DateTime @map("start_date") @db.Timestamptz
  endDate     DateTime @map("end_date") @db.Timestamptz
  ownerId     String?  @map("owner_id")
  status      String   @default("pending")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, startDate])
  @@map("calendar_events")
}

model TaskDependency {
  id          String   @id @default(cuid())
  fromTaskId  String   @map("from_task_id")
  toTaskId    String   @map("to_task_id")
  type        String   @default("blocks")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@unique([fromTaskId, toTaskId])
  @@map("task_dependencies")
}

// ============================================
// LIVE RUNTIME (N3)
// ============================================

// Written fire-and-forget from services/live, so sessionId is a plain indexed
// column rather than a relation: the recording insert must not fail because the
// session row lost its own race.
model LiveRecording {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  url            String
  durationMs     Int?     @map("duration_ms")
  framesRendered Int?     @map("frames_rendered")
  savedAt        DateTime @map("saved_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([sessionId])
  @@map("live_recordings")
}

model LiveChatMessage {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  message   String
  timestamp DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([sessionId, timestamp])
  @@map("live_chat_messages")
}

// ============================================
// MARKETPLACE
// ============================================

model MarketplaceItem {
  id            String   @id @default(cuid())
  name          String
  type          String
  // Money, so Decimal rather than Float: the service already tolerates either
  // by coercing with Number() on read.
  price         Decimal  @db.Decimal(12, 2)
  description   String
  previewUrl    String   @map("preview_url")
  creatorId     String   @map("creator_id")
  status        String   @default("active") // active|sold|removed
  featured      Boolean  @default(false)
  category      String
  purchaseCount Int      @default(0) @map("purchase_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  purchases MarketplacePurchase[]
  reviews   MarketplaceReview[]
  wishlists WishlistItem[]

  @@index([creatorId])
  @@index([status, featured])
  @@map("marketplace_items")
}

// ============================================
// TALENT
// ============================================

model TalentProfile {
  id            String   @id @default(cuid())
  name          String
  skills        String[] @default([])
  portfolio     String[] @default([])
  // { hourly?, daily?, project? } — sparse and rate-card shaped, so Json
  // rather than three nullable columns.
  rates         Json     @default("{}")
  availability  String   @default("available") // available|busy|unavailable
  averageRating Decimal  @default(0) @db.Decimal(3, 2) @map("average_rating")
  reviewCount   Int      @default(0) @map("review_count")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@index([availability])
  @@map("talent_profiles")
}

model TalentBooking {
  id        String   @id @default(cuid())
  talentId  String   @map("talent_id")
  projectId String   @map("project_id")
  scope     String
  // { start, end } as ISO strings, matching the Booking interface.
  dates     Json     @default("{}")
  rate      Decimal  @db.Decimal(12, 2)
  status    String   @default("pending") // pending|accepted|declined|completed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  @@index([talentId])
  @@index([projectId])
  @@map("talent_bookings")
}

// ============================================
// RECEIPTS
// ============================================

// The service's own id field is `receiptId`; it is the primary key here rather
// than a second identifier alongside a generated `id`.
model Receipt {
  receiptId String   @id @map("receipt_id")
  userId    String   @map("user_id")
  action    String
  details   Json     @default("{}")
  status    String   @default("confirmed") // confirmed|pending|failed
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  @@index([userId, createdAt])
  @@map("receipts")
}

// ============================================
// CONSOLE PERSISTENCE (issue #58)
// ============================================
// Fourteen models the apps/web routes already claimed to manage but the schema
// never defined. Each exists because a route says it does, not speculatively;
// docs/persistence.md section 5 lists the route that claims each one.
//
// These use cuid() ids and String foreign keys, matching the newer half of this
// schema (MarketplaceItem, CalendarEvent, Receipt) rather than the uuid/@db.Uuid
// convention of the original core tables. Mixing is unfortunate, but changing
// the core tables' key type is a separate migration with a data backfill.

/// Folder tree for the asset library. Parent is null at the root.
model AssetFolder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  parent   AssetFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children AssetFolder[] @relation("FolderTree")

  @@index([userId])
  @@index([parentId])
  @@map("asset_folders")
}

/// A generated avatar, optionally paired with a voice.
model Avatar {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String
  status     String   @default("draft") // draft|processing|ready|failed
  sourceType String   @default("upload") @map("source_type") // upload|photo|generated
  previewUrl String?  @map("preview_url")
  modelUrl   String?  @map("model_url")
  voiceId    String?  @map("voice_id")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  voice Voice? @relation(fields: [voiceId], references: [id])

  @@index([userId])
  @@map("avatars")
}

/// A synthetic voice available for pairing with avatars and audio.
model Voice {
  id         String   @id @default(cuid())
  /// Null for the built-in catalogue; set for a cloned voice owned by a user.
  userId     String?  @map("user_id")
  name       String
  provider   String   @default("builtin")
  language   String   @default("en-US")
  gender     String?
  previewUrl String?  @map("preview_url")
  isCloned   Boolean  @default(false) @map("is_cloned")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  avatars Avatar[]

  @@index([userId])
  @@map("voices")
}

/// A reusable brand kit. Distinct from Project.brandKit, which is one project's
/// inline snapshot; this is the library that a project's kit is assigned from.
model BrandKit {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  orgId      String?  @map("org_id")
  name       String
  colors     Json     @default("[]")
  fonts      Json     @default("[]")
  logoUrl    String?  @map("logo_url")
  sonicUrl   String?  @map("sonic_url")
  /// Projects this kit has been assigned to.
  projectIds String[] @default([]) @map("project_ids")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@map("brand_kits")
}

/// A custom domain pointing at a published project.
model CustomDomain {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  domain      String    @unique
  status      String    @default("pending") // pending|verifying|active|failed
  verifyToken String    @map("verify_token")
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz
  projectId   String?   @map("project_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("custom_domains")
}

/// A timeline marker on a project or shot.
model Marker {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  shotId    String?  @map("shot_id")
  label     String
  timeMs    Int      @map("time_ms")
  color     String   @default("#7c3aed")
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([projectId, timeMs])
  @@map("markers")
}

/// A script document, and the source for push-to-timeline.
model Script {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  title     String
  format    String   @default("screenplay") // screenplay|storyboard|outline
  content   String   @default("")
  /// Parsed scene/beat structure, written by the generator.
  structure Json     @default("{}")
  status    String   @default("draft") // draft|final
  wordCount Int      @default(0) @map("word_count")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId])
  @@index([projectId])
  @@map("scripts")
}

/// One generated take of a shot. A shot keeps every take; the selected one is
/// flagged rather than the others being deleted.
model ShotTake {
  id         String   @id @default(cuid())
  shotId     String   @map("shot_id")
  jobId      String?  @map("job_id")
  takeNumber Int      @map("take_number")
  status     String   @default("queued") // queued|running|complete|failed
  outputUrl  String?  @map("output_url")
  thumbUrl   String?  @map("thumb_url")
  durationMs Int?     @map("duration_ms")
  selected   Boolean  @default(false)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([shotId, takeNumber])
  @@map("shot_takes")
}

/// A pending invitation to join a team. Distinct from Membership, which is the
/// accepted state.
model TeamInvitation {
  id         String    @id @default(cuid())
  teamId     String?   @map("team_id")
  orgId      String?   @map("org_id")
  email      String
  role       String    @default("member")
  status     String    @default("pending") // pending|accepted|revoked|expired
  token      String    @unique
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  resentAt   DateTime? @map("resent_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, status])
  @@index([teamId])
  @@map("team_invitations")
}

/// An authenticated browser/device session, so the console can list and revoke.
model UserSession {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  userAgent    String?   @map("user_agent")
  ip           String?
  location     String?
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

/// A configured outbound webhook. WebhookDelivery records attempts against it.
model WebhookEndpoint {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  url           String
  events        String[]  @default([])
  secret        String
  active        Boolean   @default(true)
  lastStatus    Int?      @map("last_status")
  lastTriggered DateTime? @map("last_triggered") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId])
  @@map("webhook_endpoints")
}

/// A completed marketplace purchase. Grants library access to the buyer.
model MarketplacePurchase {
  id         String   @id @default(cuid())
  itemId     String   @map("item_id")
  buyerId    String   @map("buyer_id")
  sellerId   String   @map("seller_id")
  priceCents Int      @map("price_cents")
  /// Platform's cut in cents; the remainder is the seller's earnings.
  feeCents   Int      @map("fee_cents")
  status     String   @default("complete") // complete|refunded
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  item MarketplaceItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("marketplace_purchases")
}

/// A review left on a marketplace item.
model MarketplaceReview {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  authorId  String   @map("author_id")
  rating    Int
  body      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  item MarketplaceItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, authorId])
  @@index([itemId])
  @@map("marketplace_reviews")
}

/// A marketplace item a user has saved for later.
model WishlistItem {
  id        String   @id @default(cuid())
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  item MarketplaceItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, userId])
  @@index([userId])
  @@map("wishlist_items")
}
